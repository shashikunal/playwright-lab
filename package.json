{
  "name": "playwright-industrial-lab",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run build -w @pil/shared && concurrently -n api,web -c blue,orange \"npm run dev -w @pil/api\" \"npm run dev -w @pil/web\"",
    "build": "npm run build -w @pil/shared && npm run build -w @pil/api && npm run build -w @pil/web",
    "typecheck": "npm run build -w @pil/shared && npm run typecheck -w @pil/api && npm run typecheck -w @pil/web",
    "lint": "eslint .",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "test:e2e:chrome": "playwright test --project=chromium",
    "test:e2e:firefox": "playwright test --project=firefox",
    "test:e2e:webkit": "playwright test --project=webkit",
    "test:e2e:mobile": "playwright test --project=mobile-chrome",
    "test:e2e:ui": "playwright test --ui",
    "test:visual": "playwright test --grep @visual",
    "start:lab": "npm run dev"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.28.0",
    "@playwright/test": "^1.52.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.28.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.2.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.1"
  },
  "engines": {
    "node": ">=20"
  }
}
